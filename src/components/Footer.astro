---
import logoLight from '../assets/logo-light.png';
import { site, services, u } from '../data/site';
---
<footer class="footer on-dark">
<div class="footer-in">
<div class="footer-top">
<div>
<a class="logo" href={u('/')}><img src={logoLight.src} alt="Parallel Accounting" width={logoLight.width} height={logoLight.height} loading="lazy" style="display:block;height:48px;width:auto"></a>
<p class="small footer-note" style="margin-top:var(--space-5)">Bookkeeping, payroll and CFO work for small and growing businesses across British Columbia.</p>
</div>
<div>
<p class="footer-h">Services</p>
<ul class="footer-l">
{services.map((s) => <li><a class="footer-a" href={u(`/services/#${s.slug}`)}>{s.name}</a></li>)}
</ul>
</div>
<div>
<p class="footer-h">Company</p>
<ul class="footer-l">
<li><a class="footer-a" href={u('/about/')}>About</a></li>
<li><a class="footer-a" href={u('/services/#industries')}>Who we work with</a></li>
<li><a class="footer-a" href={u('/blog/')}>Blog</a></li>
<li><a class="footer-a" href={u('/contact/')}>Contact</a></li>
</ul>
</div>
<div>
<p class="footer-h">Get in touch</p>
<ul class="footer-l">
<li><a class="tel" href={site.tel}>{site.phone}</a></li>
<li><a class="small" href={site.mailto}>{site.email}</a></li>
<li><span class="small muted">{site.address}</span></li>
<li><span class="small muted ph">{site.hours}</span></li>
</ul>
</div>
</div>
<div class="footer-btm">
<span>Parallel Accounting &middot; Victoria, BC</span>
<span class="muted">&copy; {new Date().getFullYear()} Parallel Accounting</span>
</div>
</div>
</footer>
